# Copier ce fichier en `.env` (ignoré par git) puis renseigner les valeurs.
# Les valeurs sont compilées dans l'app :
#   flutter run --dart-define-from-file=.env
#   flutter build ipa --dart-define-from-file=.env
# Sans SENTRY_DSN, Sentry n'est pas démarré (dev local, tests).

# Sentry → Settings → Projects → pomodocus → Client Keys (DSN)
SENTRY_DSN=

# production | staging | development (défaut : production en release, development sinon)
SENTRY_ENVIRONMENT=production

# Part des transactions envoyées pour le suivi des performances (0 à 1). 0 = erreurs seulement.
SENTRY_TRACES_SAMPLE_RATE=0

# Facultatif : nom de release Sentry (défaut : <bundle id>@<version>+<build>)
# SENTRY_RELEASE=

# Ne JAMAIS mettre SENTRY_AUTH_TOKEN ici : tout ce fichier part dans la build.
# Le jeton va dans sentry.properties (voir sentry.properties.example) ou en variable d'environnement.
